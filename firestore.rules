rules_version = '2';

// Mirrors the access model described in docs/ARCHITECTURE.md §4.
// - Admin: full read/write on management collections.
// - Judge: create-only scores for items they're assigned to, while the item
//   is `ongoing`; cannot update/delete a submitted score.
// - Public: read-only on `results` (published only) and `groupTotals`.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isJudge() {
      return role() == 'judge';
    }

    function assignedItems() {
      return isJudge() ? request.auth.token.assignedItems : [];
    }

    match /fests/{festId} {
      allow read: if true;
      allow write: if isAdmin();

      match /groups/{groupId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /groupTotals/{groupId} {
        allow read: if true;
        allow write: if false; // Cloud Functions only (service account bypasses rules).
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /students/{studentId} {
        allow read: if isAdmin() || isJudge();
        allow write: if isAdmin();
      }

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /registrations/{registrationId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /judges/{judgeId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      match /results/{itemId} {
        allow read: if isAdmin() || (resource.data.published == true);
        allow write: if false; // Cloud Functions only.
      }

      match /posters/{posterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /scores/{scoreId} {
      allow read: if isAdmin() ||
        (isJudge() && resource.data.judgeId == request.auth.uid);
      allow create: if isJudge()
        && request.resource.data.judgeId == request.auth.uid
        && request.resource.data.itemId in assignedItems();
      allow update, delete: if false; // append-only — see ARCHITECTURE.md §4.
    }
  }
}
