rules_version = '2';

// Access model for the Madrasa Meelad Fest Manager — see
// docs/ARCHITECTURE.md §4.
//
// Roles live in `roles/{uid}` documents, NOT in custom auth claims:
// claims can only be set by the Admin SDK (a server), and Cloud Functions
// require Firebase's paid Blaze plan. This app is designed to run entirely
// on the no-cost Spark plan, so rules read the role document instead.
//
//   roles/{uid} = { role: "admin" }
//   roles/{uid} = { role: "judge", judgeId: "<judges/ doc id>" }
//
// `roles` is not writable by anyone through the app — an institution's
// owner creates these documents by hand in the Firebase console. That is
// what makes it safe to trust as the source of authority.
//
// Known limitation: with no server, results are computed and written by
// the client that submits the final score. These rules restrict WHO may
// write a result and WHAT SHAPE it takes, but cannot verify the marks were
// averaged correctly — an assigned judge could write a dishonest result.
// Publishing stays admin-only, so nothing reaches the public screen
// without an admin's action. See README "Why no Cloud Functions".
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    function hasRoleDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function isAdmin() {
      return hasRoleDoc() && roleDoc().role == 'admin';
    }

    function isJudge() {
      return hasRoleDoc() && roleDoc().role == 'judge';
    }

    function myJudgeId() {
      return roleDoc().judgeId;
    }

    // Whether this judge is assigned to the item they're writing about.
    // Replaces the old `assignedItems` custom claim by reading the judge's
    // own document, which only an admin can write.
    function isAssignedTo(festId, itemId) {
      return isJudge()
        && itemId in get(/databases/$(database)/documents/fests/$(festId)/judges/$(myJudgeId())).data.assignedItemIds;
    }

    // An admin may grant roles — that's how "Add Judge" gives a new account
    // its judge role without a server. The FIRST admin still has to be
    // created by hand in the Firebase console: nothing can grant the first
    // role but the console, which is what stops a stranger bootstrapping
    // themselves into one.
    //
    // Note this does mean an admin can create another admin. Admins are the
    // institution's own staff and already have full write access to every
    // collection, so this grants no authority they didn't already have.
    match /roles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // create/update and delete are separate: on a delete there is no
      // request.resource, so a single `allow write` carrying these field
      // checks would reject every deletion.
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'judge']
        // A judge role must name the judges/ record it acts as, or the
        // scores rules below have nothing to check an assignment against.
        && (request.resource.data.role == 'admin' || request.resource.data.judgeId is string);
      allow delete: if isAdmin();
    }

    match /fests/{festId} {
      allow read: if true;
      allow write: if isAdmin();

      match /groups/{groupId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Students carry names, class and photos of minors — never public.
      match /students/{studentId} {
        allow read: if isAdmin() || isJudge();
        allow write: if isAdmin();
      }

      match /items/{itemId} {
        allow read: if true;
        // Judges may only touch assignedJudgeIds/status on items they're
        // assigned to (finalizing sets status to 'completed'); everything
        // else about an item is the admin's.
        allow write: if isAdmin();
        allow update: if isAssignedTo(festId, itemId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      match /judges/{judgeId} {
        allow read: if isAdmin() || (isJudge() && judgeId == myJudgeId());
        allow write: if isAdmin();
      }

      // Written by whoever submits the last score for an item (admin or an
      // assigned judge). `published` is admin-only in both directions, so a
      // judge can neither publish nor unpublish.
      match /results/{itemId} {
        allow read: if isAdmin() || isJudge() || resource.data.published == true;
        allow create: if isAdmin()
          || (isAssignedTo(festId, itemId) && request.resource.data.published == false);
        allow update: if isAdmin()
          || (isAssignedTo(festId, itemId)
              && request.resource.data.published == resource.data.published);
        allow delete: if isAdmin();
      }

      // Daily attendance, one document per student per day. Not public:
      // it is a register of named minors and who was missing on a given
      // day, which is nobody's business but the madrasa's.
      match /attendance/{recordId} {
        allow read: if isAdmin() || isJudge();
        allow write: if isAdmin();
      }

      match /posters/{posterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Flat top-level (not nested under fests/{festId}) — matches how the
    // client queries them (filtered by an itemId field).
    match /registrations/{registrationId} {
      // Admins and judges only. These carry the name of every participating
      // student, and only the Judge Panel and the admin screens read them —
      // no public screen does. Winners' names do reach the public, but via
      // published results, which is a deliberate announcement rather than
      // handing out the full roster of minors to anyone with the app URL.
      allow read: if isAdmin() || isJudge();
      allow write: if isAdmin();
    }

    match /scores/{scoreId} {
      // Any judge may read marks, not only their own. That is not laxness:
      // with no server, the device that submits the last mark is what
      // computes the result, and to average an item it must read every
      // judge's mark for it. Firestore rejects a query it cannot prove
      // stays inside the rule, so a rule of "your own marks only" makes
      // that query — and therefore every result — impossible.
      //
      // The bias protection that matters is still intact: marks are
      // create-once and never editable (below), so a judge cannot revise
      // theirs after seeing anyone else's. The Judge Panel also only ever
      // shows a judge their own. What's given up is that a determined
      // judge could read others' raw marks through the API.
      allow read: if isAdmin() || isJudge();
      // Append-only: a judge writes their own mark once and can't revise it
      // after seeing anyone else's. The festId on the document is what lets
      // the assignment check above find the right judges/ collection.
      allow create: if isJudge()
        && request.resource.data.judgeId == myJudgeId()
        && isAssignedTo(request.resource.data.festId, request.resource.data.itemId);
      // A judge can never revise a mark after seeing what others gave —
      // that's the bias protection, and it stays absolute for them.
      //
      // An admin can, because someone must be able to correct a mis-keyed
      // mark and there is no server-side back office to do it from. The
      // app re-derives the item's result after any such edit, so a
      // published standing can't disagree with the marks behind it.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
