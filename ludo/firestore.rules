rules_version = '2';

// Access model for Ludo Circle.
//
// Everyone signs in anonymously, so `request.auth.uid` identifies a device
// rather than a person. What the rules protect is therefore not privacy —
// there is nothing private in a game of Ludo — but the integrity of a game
// in progress: that only the players in a room can touch it, and that only
// the player whose turn it is can move.
//
// The one rule worth reading carefully is the update rule on /rooms. The
// room document stores `seatByUid` — a plain uid -> seat map — purely so
// this rule can be written at all: Firestore rules cannot search an array
// of objects, so the seat could not be looked up from the `players` array.
//
// What these rules CANNOT enforce, stated honestly: the dice. With no
// server, the rolling device generates its own number and writes it, so a
// determined player could edit the app and roll sixes forever. Every roll
// and move is written into the game log that all players can see, which is
// the practical check among people who know each other, but it is not
// cryptographic. A server (or a commit-reveal scheme between players) is
// what would fix it, and both were out of scope for a free, serverless app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /rooms/{code} {
      // Membership is tested with `in` rather than by indexing the map:
      // indexing a key that isn't there is an error in rules, not null,
      // which would deny the very writes that add you to the room.
      function inRoomBefore() {
        return isSignedIn() && request.auth.uid in resource.data.seatByUid;
      }
      function inRoomAfter() {
        return isSignedIn() && request.auth.uid in request.resource.data.seatByUid;
      }
      function isMyTurn() {
        return inRoomBefore()
          && resource.data.game != null
          && resource.data.seatByUid[request.auth.uid] == resource.data.game.turn;
      }

      // Anyone signed in may read a room: you have to be able to see it to
      // decide whether to join, and the code is the only thing gating it.
      allow read: if isSignedIn();

      // The creator must put themselves in as host — nobody can conjure a
      // room that is already someone else's.
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && inRoomAfter();

      allow update: if isSignedIn() && (
        // Joining a lobby, or changing one you are already in. Requiring
        // membership on one side or the other is what stops a signed-in
        // stranger who guessed a code from rewriting someone's lobby.
        (resource.data.status == 'lobby' && (inRoomBefore() || inRoomAfter()))
        // Leaving, at any point in the game: you were in the room, and
        // after the write you are not.
        || (inRoomBefore() && !inRoomAfter())
        // In play, only the seat whose turn it is may write the board.
        // This is what stops another player moving your tokens.
        || isMyTurn()
        // The host can always write: somebody has to be able to remove a
        // player who has gone offline mid-game, or restart a stuck round.
        || resource.data.hostUid == request.auth.uid
      );

      // Leaving a room deletes it when the last player goes.
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      // Who is in the room right now and whether their microphone is on.
      // Kept out of the room document so that writing it is not blocked by
      // the turn rule above.
      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      // WebRTC handshake messages for voice: an offer, an answer and some
      // ICE candidates, each addressed to one player. A message can only be
      // sent in your own name, and only its recipient may read or delete it
      // — which they do as soon as they have consumed it.
      match /signals/{signalId} {
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow read, delete: if isSignedIn() && resource.data.to == request.auth.uid;
        allow update: if false;
      }

      // Thrown emoji. Everyone in the room sees them, but you can only
      // throw in your own name and only clear up your own — so nobody can
      // put words in another player's mouth or wipe the room's reactions.
      match /emotes/{emoteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
