{
  "name": "madrasa-fest-mobile",
  "version": "1.0.0",
  "description": "Android app wrapper for the Madrasa Meelad Fest Manager web app, built with Capacitor.",
  "private": true,
  "scripts": {
    "build:plugins": "esbuild plugins-src/capacitor-plugins.js --bundle --format=iife --outfile=www/js/vendor/capacitor-plugins.js",
    "sync": "npm run build:plugins && cap sync android",
    "assets": "capacitor-assets generate --android",
    "open:android": "cap open android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.24.2"
  }
}
